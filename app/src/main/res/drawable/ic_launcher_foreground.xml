<?xml version="1.0" encoding="utf-8"?>
<!-- The mark: a rounded, teal-gradient tile with a play triangle — the same visual grammar as
     the colored-initials badge ChannelRow draws per channel (ui/components/ChannelRow.kt's
     ChannelInitials), so the app's own icon reads as a member of its own UI family rather than
     a generic media-app glyph. Kept within the adaptive-icon safe zone (the inner ~66dp circle
     of the 108dp viewport) so no launcher mask clips it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M39,31 H69 A8,8 0 0 1 77,39 V69 A8,8 0 0 1 69,77 H39 A8,8 0 0 1 31,69 V39 A8,8 0 0 1 39,31 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="31"
                android:startY="31"
                android:endX="77"
                android:endY="77"
                android:type="linear">
                <item android:color="#66D8FF" android:offset="0.0" />
                <item android:color="#118599" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M47,43 L65,54 L47,65 Z" />
</vector>
